{
	"name": "county-cricket-live",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Unofficial fan site for men's county cricket scores — OddHours Harbour / petrol.",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.3",
	"scripts": {
		"dev": "vite dev --host 0.0.0.0 --port 5173",
		"build": "vite build",
		"preview": "vite preview --host 0.0.0.0 --port 4173",
		"ingest": "tsx src/lib/ingest/cli.ts",
		"ingest:watch": "tsx src/lib/ingest/cli.ts --watch",
		"start": "node build",
		"start:with-ingest": "sh scripts/start.sh",
		"db:reset": "tsx src/lib/server/reset.ts",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
	},
	"dependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"better-sqlite3": "^12.11.1",
		"svelte": "^5.57.0",
		"vite": "^7.3.6",
		"zod": "^4.6.2",
		"tsx": "^4.23.13"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22.20.2",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.70.0",
		"vitest": "^5.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	}
}
