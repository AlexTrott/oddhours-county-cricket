# Path to the SQLite file. Created and seeded on first boot if missing.
DATABASE_PATH=data/county-cricket.sqlite

# Public origin for adapter-node (set this in production).
ORIGIN=http://localhost:5173

# Optional public takedown mailbox. GitHub issues is the published contact if unset.
# TAKEDOWN_EMAIL=you@example.com

# Run pnpm ingest --watch beside the Node server (scripts/start.sh / docker-compose ingest).
# INGEST_WATCH=1
