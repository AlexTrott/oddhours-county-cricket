# Path to the SQLite file. Created and seeded on first boot if missing.
DATABASE_PATH=data/county-cricket.sqlite

# Public origin for adapter-node (set this in production).
ORIGIN=http://localhost:5173

# Live ESPN JSON ingest. Default is off — the UI keeps working from seed.
INGESTION_ENABLED=false

# Used in the ingest User-Agent. Keep the example.com placeholder until a real contact is locked.
# INGEST_CONTACT_EMAIL=takedown@example.com
